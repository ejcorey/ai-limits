<?xml version="1.0" encoding="utf-8"?>
<!--
  Padding for the status and navigation bars is applied at runtime from the real
  window insets (see MainActivity.applyInsets); targetSdk 35 draws edge-to-edge on
  Android 15 whatever this layout says, so a hardcoded top margin would be wrong on
  some devices and short on others.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Auspex"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Your Claude + Codex limits — standalone, shares nothing with other apps or devices"
            android:textColor="@color/text2"
            android:textSize="13sp" />

        <!-- ============ live widget preview ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Widget preview" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Exactly what the home screen will draw, with your current data and settings."
                android:textColor="@color/text2"
                android:textSize="12sp" />

            <ImageView
                android:id="@+id/preview"
                android:layout_width="match_parent"
                android:layout_height="168dp"
                android:layout_marginTop="12dp"
                android:adjustViewBounds="true"
                android:contentDescription="Widget preview"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Style"
                    android:textColor="@color/text2"
                    android:textSize="13sp" />

                <Spinner
                    android:id="@+id/spinnerStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seekPreviewSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="45" />

            <TextView
                android:id="@+id/previewSizeLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Drag to see how it reflows when resized"
                android:textColor="@color/text2"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- ============ Claude ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Claude"
                android:textColor="@color/claude"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/claudeStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Not signed in"
                android:textColor="@color/text2"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/claudeRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/claudeWindows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnClaudeSignIn"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:text="Sign in" />

                <Button
                    android:id="@+id/btnClaudePaste"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:minWidth="0dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="Paste" />

                <Button
                    android:id="@+id/btnClaudeSignOut"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Out" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============ Codex ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Codex"
                android:textColor="@color/codex"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/codexStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Not signed in"
                android:textColor="@color/text2"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/codexRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/codexWindows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnCodexSignIn"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:text="Sign in" />

                <Button
                    android:id="@+id/btnCodexPaste"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:minWidth="0dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="Paste" />

                <Button
                    android:id="@+id/btnCodexSignOut"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Out" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============ Gemini ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gemini"
                android:textColor="@color/gemini"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/geminiStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Not signed in"
                android:textColor="@color/text2"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/geminiRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/geminiWindows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnGeminiSignIn"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:text="Sign in" />

                <Button
                    android:id="@+id/btnGeminiPaste"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:minWidth="0dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="Paste" />

                <Button
                    android:id="@+id/btnGeminiSignOut"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Out" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============ widget appearance ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Widget appearance" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swShowClaude"
                style="@style/Row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Show Claude" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swShowCodex"
                style="@style/Row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Show Codex" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swShowGemini"
                style="@style/Row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Show Gemini" />

            <TextView
                android:id="@+id/soloHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="With one provider hidden, the other gets a full row per window."
                android:textColor="@color/text2"
                android:textSize="11sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Theme"
                    android:textColor="@color/text2"
                    android:textSize="13sp" />

                <Spinner
                    android:id="@+id/spinnerTheme"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <TextView
                android:id="@+id/opacityLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Background opacity"
                android:textColor="@color/text2"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/seekOpacity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="60"
                android:progress="60" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swProjection"
                style="@style/Row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Warn when on pace to hit the cap" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swSparkline"
                style="@style/Row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Show trend sparklines on tall widgets" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swTokens"
                style="@style/Row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Prefer exact counts over percentages" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Only where the provider publishes one. Gemini reports tokens remaining; Claude and Codex publish percentages only, so nothing is invented for them."
                android:textColor="@color/text2"
                android:textSize="11sp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swPace"
                style="@style/Row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Compare spend against the clock" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="“1.8× pace” means you are burning the window nearly twice as fast as it refills."
                android:textColor="@color/text2"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- ============ alerts ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alerts" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swNotify"
                style="@style/Row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Notify me when a window fills up" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alert at"
                    android:textColor="@color/text2"
                    android:textSize="13sp" />

                <Spinner
                    android:id="@+id/spinnerThreshold"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fires once per window per reset period, not on every refresh."
                android:textColor="@color/text2"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- ============ refresh ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Refresh" />

            <Button
                android:id="@+id/btnRefresh"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Refresh usage now" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Automatically every"
                    android:textColor="@color/text2"
                    android:textSize="13sp" />

                <Spinner
                    android:id="@+id/spinnerInterval"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <TextView
                android:id="@+id/updated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="@color/text2"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnDiagnostics"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Copy diagnostics" />
        </LinearLayout>

        <TextView
            android:id="@+id/placedHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Your widgets"
            android:textColor="@color/text"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/placedWidgets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="Add a widget: long-press the home screen → Widgets → Auspex. Every style resizes, and each placed widget can be set up on its own — tap it above, or long-press it on the home screen."
            android:textColor="@color/text2"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
