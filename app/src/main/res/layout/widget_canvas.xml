<?xml version="1.0" encoding="utf-8"?>
<!--
  The whole widget is one rendered bitmap (see WidgetRenderer). The overlay is an
  invisible hit region for "Open app"; the renderer only reveals it on the sizes
  where the footer is actually drawn.

  EVERY tag here must be a class annotated @RemoteViews.RemoteView. RemoteViews
  inflates through a LayoutInflater.Filter that rejects anything else, and the
  launcher reports only "Couldn't add widget" when it does. A plain <View> is NOT
  on that list — FrameLayout is. WidgetLayoutTest enforces this.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_canvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter" />

    <FrameLayout
        android:id="@+id/widget_settings"
        android:layout_width="76dp"
        android:layout_height="26dp"
        android:layout_gravity="bottom|end"
        android:visibility="gone" />
</FrameLayout>
